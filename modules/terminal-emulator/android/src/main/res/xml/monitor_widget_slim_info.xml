<?xml version="1.0" encoding="utf-8"?>
<!-- MONITOR 4x2: four cameras in one row. Push-only, like the 4x3 one. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:minWidth="250dp"
  android:minHeight="110dp"
  android:minResizeWidth="220dp"
  android:minResizeHeight="70dp"
  android:targetCellWidth="4"
  android:targetCellHeight="2"
  android:updatePeriodMillis="0"
  android:initialLayout="@layout/monitor_widget_slim"
  android:previewLayout="@layout/monitor_widget_slim"
  android:description="@string/monitor_widget_description_slim"
  android:resizeMode="horizontal|vertical"
  android:widgetCategory="home_screen" />
