            android:textColor="#FFFF4436" android:textSize="11sp" android:shadowColor="#FF000000" android:shadowRadius="3" android:shadowDx="0" android:shadowDy="0"
            android:visibility="gone" />
          <FrameLayout
            android:id="@+id/monitor_cam_2_bang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp" />

          <TextView
            android:id="@+id/monitor_cam_2_ch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="3dp"
            android:fontFamily="monospace"
            android:text="CH-02"
            android:textColor="#FFEAF5EE"
            android:textSize="11sp"
            android:shadowColor="#FF000000" android:shadowRadius="3" android:shadowDx="0" android:shadowDy="0" />
        </FrameLayout>
      </LinearLayout>
      <LinearLayout
        android:id="@+id/monitor_cam_3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2dp"
        android:background="@drawable/monitor_cam_bg"
        android:orientation="vertical"
