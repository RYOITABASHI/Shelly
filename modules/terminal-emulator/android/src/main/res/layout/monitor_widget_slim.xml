            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_margin="3dp"
            android:fontFamily="monospace" android:text="@string/monitor_widget_rec"
            android:textColor="#FFFF4436" android:textSize="11sp" android:shadowColor="#FF000000" android:shadowRadius="3" android:shadowDx="0" android:shadowDy="0"
            android:visibility="gone" />
          <FrameLayout
            android:id="@+id/monitor_cam_3_bang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp" />

          <TextView
            android:id="@+id/monitor_cam_3_ch"
            android:layout_width="wrap_content"
