            android:layout_gravity="top|start"
            android:layout_margin="3dp"
            android:fontFamily="monospace"
            android:text="CH-03"
            android:textColor="#FFEAF5EE"
            android:textSize="11sp"
            android:shadowColor="#FF000000" android:shadowRadius="3" android:shadowDx="0" android:shadowDy="0" />
        </FrameLayout>
      </LinearLayout>
      <LinearLayout
        android:id="@+id/monitor_cam_4"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2dp"
        android:background="@drawable/monitor_cam_bg"
        android:orientation="vertical"
        android:padding="1dp">

        <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:background="#FF03100A">

          <ImageView
            android:id="@+id/monitor_cam_4_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
