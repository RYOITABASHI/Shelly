              android:layout_height="wrap_content"
              android:layout_marginStart="4dp"
              android:fontFamily="monospace"
              android:singleLine="true"
              android:textColor="#FFEAF5EE"
              android:textSize="10sp" />
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
