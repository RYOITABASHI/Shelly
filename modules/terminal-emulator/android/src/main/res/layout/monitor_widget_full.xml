          android:layout_height="0dp"
          android:layout_weight="1"
          android:background="#FF03100A">

          <ImageView
            android:id="@+id/monitor_cam_1_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/monitor_operator_1_dim"
            android:contentDescription="@null" />

          <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/monitor_scanlines" />

          <TextView
            android:id="@+id/monitor_cam_1_nosignal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF060B09"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="@string/monitor_widget_no_signal"
            android:textColor="#FF6C7A71"
            android:textSize="12sp"
            android:visibility="gone" />

          <!-- REC blink + noise frames: MonitorWidgetRenderer addView()s a
               ViewFlipper (layout/monitor_cam_rec_N) here ONLY while this
               camera is RUNNING, and removeAllViews() otherwise, so an idle
               widget has no flipper that could keep ticking. -->
          <FrameLayout
            android:id="@+id/monitor_cam_1_rec"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

          <!-- Waiting for approval: steady REC + blinking "!" (added the same way). -->
          <TextView
            android:id="@+id/monitor_cam_1_rec_static"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_margin="3dp"
            android:fontFamily="monospace" android:text="@string/monitor_widget_rec"
            android:textColor="#FFFF4436" android:textSize="12sp" android:shadowColor="#FF000000" android:shadowRadius="3" android:shadowDx="0" android:shadowDy="0"
            android:visibility="gone" />
          <FrameLayout
            android:id="@+id/monitor_cam_1_bang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp" />

          <TextView
            android:id="@+id/monitor_cam_1_ch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="3dp"
            android:fontFamily="monospace"
            android:text="CH-01"
            android:textColor="#FFEAF5EE"
            android:textSize="12sp"
            android:shadowColor="#FF000000" android:shadowRadius="3" android:shadowDx="0" android:shadowDy="0" />

          <TextView
            android:id="@+id/monitor_cam_1_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="3dp"
            android:background="#8C000000"
            android:fontFamily="monospace"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:singleLine="true"
            android:textColor="#FFA8F0CF"
            android:textSize="11sp" />
        </FrameLayout>

        <LinearLayout
