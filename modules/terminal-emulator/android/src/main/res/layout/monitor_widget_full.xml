            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/monitor_progress_thin" />

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
              android:id="@+id/monitor_cam_1_kind"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:background="@drawable/monitor_chip_api"
              android:fontFamily="monospace"
              android:paddingStart="3dp"
              android:paddingEnd="3dp"
              android:textColor="#FF7CC7FF"
              android:textSize="10sp"
              android:visibility="gone" />

            <TextView
              android:id="@+id/monitor_cam_1_name"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="4dp"
              android:layout_weight="1"
              android:ellipsize="end"
              android:fontFamily="monospace"
              android:singleLine="true"
              android:textColor="#FFA9B7AE"
              android:textSize="10sp" />

            <TextView
