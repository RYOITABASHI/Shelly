<?xml version="1.0" encoding="utf-8"?>
<!-- Written from a one-off generator (four near-identical cameras); edit by hand
     freely, but keep view ids in sync with monitor/MonitorWidgetRenderer.kt.
     4x3 MONITOR widget: header (MONITOR, mission bar, %, clock), one cost / approval line, 2x2 cameras.
     RemoteViews-safe views only: FrameLayout, LinearLayout, TextView,
     ImageView, ProgressBar, Chronometer (+ ViewFlipper children added at runtime). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/monitor_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/monitor_widget_bg"
  android:padding="6dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="4dp"
      android:paddingEnd="4dp">

      <TextView
        android:id="@+id/monitor_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/monitor_widget_brand"
        android:textColor="#FFA8F0CF"
        android:textSize="14sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/monitor_iteration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="monospace"
        android:textColor="#FFFFB21E"
        android:textSize="12sp"
        android:visibility="gone" />

      <ProgressBar
        android:id="@+id/monitor_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/monitor_progress" />

      <TextView
        android:id="@+id/monitor_pct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:minEms="2"
        android:gravity="end"
        android:text="0%"
        android:textColor="#FFA8F0CF"
        android:textSize="13sp" />

      <Chronometer
        android:id="@+id/monitor_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="monospace"
        android:textColor="#FFA9B7AE"
        android:textSize="13sp" />
    </LinearLayout>

    <TextView
      android:id="@+id/monitor_cost"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:fontFamily="monospace"
      android:paddingStart="4dp"
      android:paddingEnd="4dp"
      android:singleLine="true"
      android:textColor="#FFA9B7AE"
      android:textSize="11sp" />

    <TextView
      android:id="@+id/monitor_alert"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:paddingStart="4dp"
      android:paddingEnd="4dp"
      android:singleLine="true"
      android:textColor="#FFFFB21E"
      android:textSize="12sp"
      android:visibility="gone" />

    <TextView
      android:id="@+id/monitor_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:fontFamily="monospace"
      android:paddingStart="4dp"
      android:paddingEnd="4dp"
      android:singleLine="true"
      android:text="@string/monitor_widget_empty"
      android:textColor="#FF6C7A71"
      android:textSize="11sp"
      android:visibility="gone" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="horizontal">
      <LinearLayout
        android:id="@+id/monitor_cam_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2dp"
        android:background="@drawable/monitor_cam_bg"
        android:orientation="vertical"
        android:padding="1dp">

        <FrameLayout
